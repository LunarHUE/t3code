# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=example.com

# Optional: inactive tunnel cleanup. Start with dry-run, verify the cleanup
# logs, then set enabled. Unset and off both disable cleanup.
# RELAY_TUNNEL_CLEANUP_MODE=off
# Optional: cleanup for tunnels whose host never registered recovery, once they
# have been down for 30 days. Same values, independent of the mode above.
# RELAY_LEGACY_TUNNEL_CLEANUP_MODE=off
# Canary stages only: shorten the 30-day legacy grace period, in minutes.
# Ignored on prod.
# RELAY_LEGACY_TUNNEL_GRACE_MINUTES=10

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Upstream Cloudflare runtime only: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Apple Push Notification service (only when RELAY_MOBILE_PUSH_ENABLED=true).
# Set APNS_ENABLED=false for an Android-only relay.
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...

# Optional: Android push. Set this secret to the service account JSON from
# Firebase Project settings > Service accounts. Never put it in an app build.
# FCM_SERVICE_ACCOUNT={...}

# LunarHUE: existing PostgreSQL (Supabase). No PlanetScale credentials needed.
RELAY_DATABASE_PROVIDER=external
# Direct connection for Hyperdrive. Percent-encode special characters in credentials.
RELAY_DATABASE_URL=postgresql://relay:password@db.PROJECT_REF.supabase.co:5432/postgres
# Migration role; use Supabase's Session pooler on port 5432 for IPv4-only CI.
RELAY_MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# No resources/exporters/push queues or provider credentials unless enabled.
# Upstream implementations remain available behind these deployment switches.
RELAY_TELEMETRY_ENABLED=false
RELAY_MOBILE_PUSH_ENABLED=false

# Cluster runtime only: one confidential OIDC client. Keep its secret on the relay.
# Exact tenant-specific issuer from the provider discovery document.
# OIDC_ISSUER_URL=https://login.microsoftonline.com/TENANT_ID/v2.0
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_REDIRECT_URI=https://relay.example.com/auth/callback
# OIDC_SCOPES=openid profile email
# Optional alternative for providers requiring HTTP Basic client authentication.
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
# Absolute local session/refresh lifetime: 600..2592000 seconds, default seven days.
# OIDC_REFRESH_LIFETIME_SECONDS=604800
# RELAY_URL=https://relay.example.com
# RELAY_SIGNING_PRIVATE_KEY=...
# RELAY_PRIVATE_ENDPOINTS=[{"userId":"oidc_...","environmentId":"...","url":"https://environment.example.com"}]
# RELAY_PRIVATE_ENDPOINT_DOMAINS=dev.example.com
