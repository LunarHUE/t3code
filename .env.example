# Optional: enable T3 Connect in desktop/web/CLI source builds.
# This public origin is the only account configuration included in client builds.
# Leave it unset to use local environments without T3 Connect.
T3CODE_RELAY_URL=https://t3connect.lunarhue.com

# OIDC issuer, client ID and client secret belong to the relay deployment.
# Never put OIDC_CLIENT_SECRET or relay signing keys in client build env files.
# See infra/relay/README.md for server-side configuration.
